---
import Layout from "./Layout.astro";
import {Tabs} from "./tabs/tabs.ts";
import Image from "astro/components/Image.astro";
import type {CollectionEntry} from "astro:content";

interface Props {
    project: CollectionEntry<"projects">;
}

const {project} = Astro.props;
const {title, description, intro, cover, coverAlt, sourceCode} = project.data;
---

<Layout activeTab={Tabs.Projects} title={`${title} — Tal Israeli`} description={description}>
    <a class="button back-link" href="/projects">&larr; All projects</a>
    <fieldset>
        <legend>{title}</legend>
        <div class="intro">
            <p>{intro}</p>
            <Image src={cover}
                   alt={coverAlt}
                   decoding="async" width={450} quality="high" format="webp"/>
        </div>
        <div class="content">
            <slot/>
        </div>
        {sourceCode && (
                <div class="actions">
                    <a class="button"
                       href={sourceCode}
                       target="_blank"
                       rel="noopener">Source code</a>
                </div>
        )}
    </fieldset>
</Layout>

<style lang="scss">
  .back-link {
    display: inline-block;
    margin-block-end: 0.75rem;
  }

  p {
    margin: 0;
  }

  .intro {
    display: flex;
    align-items: center;
    gap: 1rem;

    p {
      flex: 1;
    }

    :global(img) {
      flex-shrink: 0;
      width: 45%;
      height: auto;
    }

    @media screen and (max-width: 500px) {
      flex-direction: column;

      :global(img) {
        width: 100%;
      }
    }
  }

  // The MDX content is rendered outside this component's scope, so its elements are styled with :global().
  .content {
    :global(p) {
      margin: 0;
    }

    :global(h3) {
      font-size: 1rem;
      font-weight: 500;
      margin: 1rem 0 0.25rem;
    }

    :global(ol) {
      line-height: 1.6;
      margin: 0.25rem 0 0;
      padding-inline-start: 1.25rem;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
  }

  .button {
    min-width: 5rem;
    padding: 0.2rem 0.75rem;
    box-sizing: border-box;
    border: var(--tab-border) 1px solid;
    background: var(--tab-button-inactive-bg);
    color: var(--text-color);
    font-size: 0.9rem;
    text-align: center;
    text-decoration: none;
    cursor: default;

    &:hover {
      border-color: var(--tab-btn-border-hover);
      background: var(--tab-btn-bg-hover);
    }
  }
</style>
