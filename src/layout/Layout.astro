---
import Header from "./header/Header.astro";
import TabPanel from "./tabs/TabPanel.astro";
import Footer from "./Footer.astro";
import type { Tabs } from "./tabs/tabs.ts";

interface Props {
    activeTab: Tabs;
}

const { activeTab } = Astro.props;
---

<html lang="en-US">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro</title>

        <!-- Apply saved theme before paint to prevent flash -->
        <script is:inline>
            (function () {
                var theme = localStorage.getItem("theme") || "light";
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>
    </head>
    <body>
        <div class="window">
            <Header />
            <TabPanel activeTab={activeTab}>
                <main>
                    <slot />
                </main>
            </TabPanel>
            <Footer />
        </div>
    </body>
</html>

<style is:global>
    :root,
    [data-theme="light"] {
        --title-bar-bg: white;
        --window-bg: #eeeef2;
        --window-border: #ccc;
        --text-color: #1f1f1f;
        --tab-bg: white;
        --tab-button-inactive-bg: linear-gradient(to bottom, #f2f2f2, #e1e1e1);
        --tab-border: #aaa;
        --menu-btn-bg-hover: #e5f1fb;
        --menu-btn-border-hover: #0076d6;
        --tab-btn-border-hover: #57b3ff;
        --tab-btn-bg-hover: linear-gradient(to bottom, #e5f1fb, #bde0ff);
        --link-color: #0066cc;
    }

    [data-theme="dark"] {
        --title-bar-bg: #2b2b2b;
        --window-bg: #333337;
        --window-border: #3f3f46;
        --text-color: #cccccc;
        --tab-bg: #252526;
        --tab-button-inactive-bg: linear-gradient(to bottom, #3c3c3f, #2d2d30);
        --tab-border: #3f3f46;
        --menu-btn-bg-hover: #234057;
        --menu-btn-border-hover: #007acc;
        --tab-btn-border-hover: #007acc;
        --tab-btn-bg-hover: linear-gradient(to bottom, #234057, #12283c);
        --link-color: #569cd6;
    }

    fieldset {
        border: var(--window-border) 1px solid;
        border-radius: 0.25rem;
        padding: 1rem;

        legend {
            font-weight: 500;
        }

        p {
            line-height: 1.6;

            &:first-of-type {
                margin-block-start: 0;
            }

            strong {
                font-weight: 500;
            }
        }
    }

    a {
        color: var(--link-color);
    }

    /* Rickroll spin animation */
    @keyframes rickroll-spin {
        0% {
            transform: rotate(0deg) scale(1);
        }
        20% {
            transform: rotate(180deg) scale(0.7);
        }
        40% {
            transform: rotate(360deg) scale(1.2);
        }
        60% {
            transform: rotate(720deg) scale(0.8);
        }
        80% {
            transform: rotate(1080deg) scale(1.1);
        }
        100% {
            transform: rotate(1440deg) scale(1);
        }
    }

    .window.rickrolled {
        animation: rickroll-spin 2.5s ease-in-out;
    }
</style>

<style lang="scss">
    $window-width: 800px;
    $window-height: 650px;

    $wallpaper:
        radial-gradient(
            ellipse at 30% 20%,
            rgba(255, 255, 255, 0.08) 0%,
            transparent 50%
        ),
        linear-gradient(135deg, #3a6ea5 0%, #2b579a 40%, #1e3a5f 100%);

    $wallpaper-dark:
        radial-gradient(
            ellipse at 30% 20%,
            rgba(255, 255, 255, 0.03) 0%,
            transparent 50%
        ),
        linear-gradient(135deg, #000029 0%, #31163e 40%, #180f1a 100%);

    body {
        margin: 0;
        height: 100dvh;
        max-height: 100dvh;
        background: $wallpaper;
        display: grid;
        place-items: center;
        font-size: 16px;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-color);
        overflow: hidden;
    }

    :global(html[data-theme="dark"]) body {
        background: $wallpaper-dark;
    }

    .window {
        width: $window-width;
        height: min($window-height, 100vh);
        border-radius: 0.5rem;
        background: var(--window-bg);
        display: grid;
        grid-template-rows: auto 1fr auto;
        overflow: hidden;
        box-shadow: 0 2px 8px 0 #0008;

        @media screen and (max-width: $window-width) {
            width: 100%;
            height: 100%;
            border-radius: 0;
            box-shadow: none;
        }
    }
</style>
