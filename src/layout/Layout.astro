---
import Header from "./header/Header.astro";
import TabPanel from "./tabs/TabPanel.astro";
import Footer from "./Footer.astro";
import type {Tabs} from "./tabs/tabs.ts";

interface Props {
    activeTab: Tabs
}

const {activeTab} = Astro.props;
---

<html lang="en-US">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <title>Astro</title>
</head>
<body>
<div class="window">
    <Header/>
    <TabPanel activeTab={activeTab}>
        <main>
            <slot/>
        </main>
    </TabPanel>
    <Footer/>
</div>
</body>
</html>

<style is:global>
    :root {
        --title-bar-bg: white;
        --window-bg: #eeeef2;
        --window-border: #ccc;
        --text-color: #1f1f1f;
        --tab-bg: white;
        --tab-button-inactive-bg: linear-gradient(to bottom, #f2f2f2, #e1e1e1);
        --tab-border: #aaa;
    }

    fieldset {
        border: var(--window-border) 1px solid;
        border-radius: 0.25rem;
        padding: 1rem;

        legend {
            font-weight: 500;
        }

        p {
            line-height: 1.6;

            &:first-of-type {
                margin-block-start: 0;
            }

            strong {
                font-weight: 500;
            }
        }
    }
</style>

<style lang="scss">
  $window-width: 800px;
  $window-height: 650px;

  $bg-color: #18181a;

  body {
    margin: 0;
    height: 100vh;
    background: $bg-color;
    display: grid;
    place-items: center;
    font-size: 16px;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    color: var(--text-color);
  }

  .window {
    width: $window-width;
    height: min($window-height, 100vh);
    border-radius: 0.5rem;
    background: var(--window-bg);
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    box-shadow: 0 4px 16px 0 black;

    @media screen and (max-width: $window-width) {
      width: 100%;
      height: 100%;
      border-radius: 0;
      box-shadow: none;
    }
  }
</style>
