---
import Layout from "../../layout/Layout.astro";
import { Tabs } from "../../layout/tabs/tabs.ts";
import Image from "astro/components/Image.astro";
import { getCollection } from "astro:content";

// Newest first. Periods start with a four-digit year, so comparing them as strings orders them by start year.
const projects = (await getCollection("projects")).sort((a, b) => b.data.period.localeCompare(a.data.period));
---

<Layout activeTab={Tabs.Projects}>
  <ul class="projects">
    {projects.map(({ id, data: project }) => (
      <li>
        <fieldset>
          <legend>{project.title}</legend>
          <div class="project">
            <Image
              src={project.cover}
              alt={project.coverAlt}
              decoding="async"
              width={600}
              quality="high"
              format="webp"
            />
            <div class="summary">
              <p>{project.summary}</p>
              <dl>
                <dt>Period:</dt>
                <dd>{project.period}</dd>
                <dt>Technologies:</dt>
                <dd>
                  <ul class="tags">
                    {project.technologies.map((technology) => (
                      <li>{technology}</li>
                    ))}
                  </ul>
                </dd>
              </dl>
              <div class="actions">
                <a class="button default" href={`/projects/${id}`}>
                  Read more
                </a>
                {project.sourceCode && (
                  <a class="button" href={project.sourceCode} target="_blank" rel="noopener">
                    Source code
                  </a>
                )}
              </div>
            </div>
          </div>
        </fieldset>
      </li>
    ))}
  </ul>
</Layout>

<style lang="scss">
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;

    > li + li {
      margin-block-start: 1rem;
    }
  }

  .project {
    display: flex;
    align-items: center;
    gap: 1rem;

    :global(img) {
      flex-shrink: 0;
      width: 35%;
      height: auto;
    }

    @media screen and (max-width: 500px) {
      flex-direction: column;
      align-items: stretch;

      :global(img) {
        width: 100%;
      }
    }
  }

  .summary {
    flex: 1;
  }

  p {
    margin: 0 0 0.75rem;
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    margin: 0 0 0.75rem;

    dt {
      font-weight: 500;
    }

    dd {
      margin: 0;
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;

    // Flat, like a WPF token: a tinted fill with a thin accent border, unlike the gradient buttons.
    li {
      padding: 0 0.4rem;
      border: var(--tab-btn-border-hover) 1px solid;
      border-radius: 2px;
      background: var(--menu-btn-bg-hover);
      color: var(--text-color);
      font-size: 0.8rem;
      line-height: 1.5;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .button {
    min-width: 5rem;
    padding: 0.2rem 0.75rem;
    box-sizing: border-box;
    border: var(--tab-border) 1px solid;
    background: var(--tab-button-inactive-bg);
    color: var(--text-color);
    font-size: 0.9rem;
    text-align: center;
    text-decoration: none;
    cursor: default;

    &.default {
      border-color: var(--menu-btn-border-hover);
    }

    &:hover {
      border-color: var(--tab-btn-border-hover);
      background: var(--tab-btn-bg-hover);
    }
  }
</style>
