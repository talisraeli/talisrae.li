---
import Layout from "../layout/Layout.astro";
import {Tabs} from "../layout/tabs/tabs.ts";
import profile from "./assets/profile.jpg";
import Image from "astro/components/Image.astro";
import GreenLight from "../components/GreenLight.astro";

const aboutRows = [
    {label: "Focus", details: "Backend, cloud and distributed systems"},
    {
        label: "Expertise",
        details: "High-performance distributed web applications in .NET, using clean architecture and robust design patterns",
    },
    {
        label: "Background",
        details: "A strong theoretical foundation from the Weizmann Institute of Science and my B.Sc. in progress at the Technion, paired with a passion for building real-world software",
    },
    {label: "Looking for", details: "An internship focused on backend or distributed cloud applications"},
];
---

<Layout activeTab={Tabs.Home}>
    <fieldset>
        <legend>About Me</legend>
        <div class="profile">
            <Image src={profile}
                   alt="Portrait of Tal Israeli"
                   width={300}
                   format="jpg"
                   quality="high"
                   decoding="async"/>
            <div>
                <h1>Tal Israeli</h1>
                <p class="role">Software Engineering Student @ Technion</p>
                <dl>
                    <dt>Location:</dt>
                    <dd>Haifa, Israel</dd>
                    <dt>GPA:</dt>
                    <dd>91.4 / 100</dd>
                    <dt>Status:</dt>
                    <dd><span class="status"><GreenLight/>Open to internships</span></dd>
                </dl>
                <div class="actions">
                    <a class="button default" href="/contact">Get in touch</a>
                    <a class="button" href="https://github.com/talisraeli" target="_blank" rel="noopener">GitHub</a>
                    <a class="button" href="https://www.linkedin.com/in/talisraeli/" target="_blank"
                       rel="noopener">LinkedIn</a>
                </div>
            </div>
        </div>
        <p>I'm a software engineer from Israel who builds cloud-native web applications.</p>
        <table>
            <tbody>
            {aboutRows.map(row => (
                    <tr>
                        <th scope="row">{row.label}</th>
                        <td>{row.details}</td>
                    </tr>
            ))}
            </tbody>
        </table>
        <p class="closing">
            Thanks for stopping by, and I hope you enjoy exploring <span class="fix-target">my <span class="spell-warning" tabindex="0"
                                                                                               aria-describedby="spell-tooltip">portfolio<span
                id="spell-tooltip" role="tooltip">
                <code>(noun) <span class="keyword">string</span> portfolio</code>
                <span class="message">
                    <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill="#e8a317" d="M8 1 15.5 15H.5z"/>
                        <path fill="#1f1f1f" d="M7.25 6h1.5v5h-1.5zM7.25 12h1.5v1.5h-1.5z"/>
                    </svg>
                    <span><span class="rule">SPELL0001:</span> Did you mean &ldquo;The best portfolio you've ever seen&rdquo;?</span>
                </span>
                <button class="fixes" type="button">Show potential fixes (Alt+Enter)</button>
            </span></span></span>!
        </p>
    </fieldset>
</Layout>

<script>
    const fixTarget = document.querySelector<HTMLElement>('.fix-target');
    const spellWarning = fixTarget?.querySelector('.spell-warning');

    const applyFix = () => {
        if (!fixTarget) return;
        fixTarget.textContent = "the best portfolio you've ever seen";
        fixTarget.classList.add('fixed');
    };

    spellWarning?.querySelector('.fixes')?.addEventListener('click', applyFix);

    document.addEventListener('keydown', (e) => {
        if (e.altKey && e.key === 'Enter' && spellWarning?.matches(':hover, :focus-within')) {
            e.preventDefault();
            applyFix();
        }
    });
</script>

<style lang="scss">
  .profile {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block-end: 1rem;

    h1 {
      font-size: 1.5rem;
      font-weight: bold;
      margin: 0;
      text-transform: uppercase;
    }

    img {
      flex-shrink: 0;
      width: 13rem;
      height: auto;
      border: var(--tab-border) 2px solid;
    }

    @media screen and (max-width: 500px) {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .role {
    margin-block-end: 0.5rem;
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    margin: 0 0 1rem;

    dt {
      font-weight: 500;
    }

    dd {
      margin: 0;

      .status {
        color: green;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .button {
    min-width: 5rem;
    padding: 0.2rem 0.75rem;
    box-sizing: border-box;
    border: var(--tab-border) 1px solid;
    background: var(--tab-button-inactive-bg);
    color: var(--text-color);
    font-size: 0.9rem;
    text-align: center;
    text-decoration: none;
    cursor: default;

    &.default {
      border-color: var(--menu-btn-border-hover);
    }

    &:hover {
      border-color: var(--tab-btn-border-hover);
      background: var(--tab-btn-bg-hover);
    }
  }

  table {
    width: 100%;
    border-collapse: collapse;
    border: var(--window-border) 1px solid;
    font-size: 0.9rem;

    th,
    td {
      padding: 0.2rem 0.5rem;
      border: var(--window-border) 1px solid;
      text-align: start;
    }

    th {
      background: var(--tab-button-inactive-bg);
      font-weight: 500;
      white-space: nowrap;
    }

    tbody tr:hover {
      background: var(--menu-btn-bg-hover);
    }
  }

  .closing {
    position: relative;
  }

  @keyframes fix-applied {
    from {
      background: var(--menu-btn-bg-hover);
    }
  }

  .fix-target.fixed {
    font-weight: 500;

    @media (prefers-reduced-motion: no-preference) {
      animation: fix-applied 1.5s ease-out;
    }
  }

  .spell-warning {
    position: relative;
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-color: #008000;
    cursor: default;

    [role="tooltip"] {
      position: absolute;
      inset-block-end: calc(100% + 0.35rem);
      inset-inline-end: 0;
      z-index: 1;
      display: grid;
      gap: 0.3rem;
      width: max-content;
      max-width: 26rem;
      padding: 0.4rem 0.6rem;
      box-sizing: border-box;
      border: var(--tab-border) 1px solid;
      background: var(--tab-bg);
      color: var(--text-color);
      box-shadow: 2px 2px 4px rgb(0 0 0 / 0.3);
      font-size: 0.8rem;
      line-height: 1.4;
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.1s;

      /* Bridges the gap to the word, so the pointer can reach the button */
      &::after {
        content: "";
        position: absolute;
        inset-block-start: 100%;
        inset-inline: 0;
        height: 0.35rem;
      }

      code {
        padding-block-end: 0.3rem;
        border-block-end: var(--tab-border) 1px solid;
        font-family: "Consolas", "Courier New", monospace;
      }

      .keyword {
        color: var(--link-color);
      }

      .fixes {
        appearance: none;
        justify-self: start;
        padding: 0;
        border: none;
        background: none;
        color: var(--link-color);
        font: inherit;
        cursor: default;

        &:hover {
          text-decoration: underline;
        }
      }

      .message {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.35rem;
      }

      svg {
        margin-block-start: 0.1rem;
      }

      .rule {
        opacity: 0.7;
      }
    }

    &:hover [role="tooltip"],
    &:focus-within [role="tooltip"] {
      visibility: visible;
      opacity: 1;
      transition-delay: 0.25s;
    }

    @media screen and (max-width: 800px) {
      position: static;

      [role="tooltip"] {
        inset-inline: 0 auto;
        max-width: 100%;
      }
    }
  }
</style>
