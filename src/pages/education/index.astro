---
import Layout from "../../layout/Layout.astro";
import {Tabs} from "../../layout/tabs/tabs.ts";
import TechnionLogo from "../assets/technion-logo.svg";
import WeizmannLogo from "../assets/weizmann-logo.svg";
import GreenLight from "../../components/GreenLight.astro";

const courses = [
    {name: "Intro. to Computer Science", grade: "100"},
    {name: "Intro. to Systems Programming", grade: "95"},
    {name: "Data Structures 1", grade: "In progress", inProgress: true},
];
---

<Layout activeTab={Tabs.Education}>
    <fieldset>
        <legend>Technion &mdash; Israel Institute of Technology</legend>
        <div class="institute-header">
            <TechnionLogo class="technion-logo" role="img" aria-label="Technion logo"/>
            <h2>Bachelor of Science (B.Sc.) in Software Engineering</h2>
        </div>
        <dl>
            <dt>Period:</dt>
            <dd>2025&ndash;Present</dd>
            <dt>Location:</dt>
            <dd>Haifa, Israel</dd>
            <dt>GPA:</dt>
            <dd>91.4 / 100</dd>
            <dt>Expected Graduation:</dt>
            <dd>June 2029</dd>
        </dl>
        <table>
            <caption>Relevant Courses</caption>
            <thead>
            <tr>
                <th scope="col">Course</th>
                <th scope="col">Grade</th>
            </tr>
            </thead>
            <tbody>
            {courses.map(course => (
                    <tr>
                        <td>{course.name}</td>
                        <td>
                            {course.inProgress
                                ? <span class="in-progress"><GreenLight/>{course.grade}</span>
                                : course.grade}
                        </td>
                    </tr>
            ))}
            </tbody>
        </table>
    </fieldset>

    <fieldset>
        <legend>Weizmann Institute of Science</legend>
        <div class="institute-header">
            <WeizmannLogo role="img" aria-label="Weizmann Institute of Science logo"/>
            <h2>&ldquo;Computer Science &mdash; Academia and Industry&rdquo; Program</h2>
        </div>
        <dl>
            <dt>Period:</dt>
            <dd>2018&ndash;2020</dd>
            <dt>Location:</dt>
            <dd>Rehovot, Israel</dd>
            <dt>Final Grade:</dt>
            <dd>100 / 100</dd>
        </dl>
        <h3>Final Project: Web Search Engine</h3>
        <p>
            A text-based web search engine I built independently for the Davidson Institute of Science Education, the
            educational arm of the Weizmann Institute, as the final project of my external high-school diploma, mentored
            by a Ph.D. Industrial Engineering lecturer.
        </p>
        <ul>
            <li>
                <strong>Web crawler:</strong> extracts page metadata, scores keywords by their dominance on each page,
                and queues linked pages, crawling hand-picked reliable domains more often.
            </li>
            <li>
                <strong>Search website:</strong> handles queries with ASP.NET Core and ranks results by keyword score,
                using the Porter stemming algorithm to match words by their root form.
            </li>
            <li>
                <strong>Technologies:</strong> .NET Core, Entity Framework Core, SQL Server, Html Agility Pack.
            </li>
            <li>
                <strong>Deployment:</strong> Amazon Web Services (AWS), with EC2 for the crawler and website and RDS for
                the database.
            </li>
        </ul>
    </fieldset>
</Layout>

<style lang="scss">
  fieldset + fieldset {
    margin-block-start: 1rem;
  }

  .institute-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block-end: 0.75rem;

    :global(svg) {
      flex-shrink: 0;
      width: auto;
      height: 108px;
    }

    :global(svg.technion-logo) {
      height: 80px;
    }

    h2 {
      font-size: 1rem;
      font-weight: 600;
      margin: 0;
    }

    @media screen and (max-width: 500px) {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  :global(html[data-theme="dark"]) .institute-header :global(svg *) {
    fill: white !important;
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    margin: 0 0 1rem;

    dt {
      font-weight: 500;
    }

    dd {
      margin: 0;
    }
  }

  h3 {
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
  }

  ul {
    line-height: 1.6;
    margin: 0;
    padding-inline-start: 1.25rem;

    strong {
      font-weight: 500;
    }
  }

  table {
    width: 100%;
    border-collapse: collapse;
    border: var(--window-border) 1px solid;
    font-size: 0.9rem;

    caption {
      text-align: start;
      font-weight: 500;
      padding-block-end: 0.25rem;
    }

    th,
    td {
      padding: 0.2rem 0.5rem;
      border: var(--window-border) 1px solid;
      text-align: start;
    }

    th {
      background: var(--tab-button-inactive-bg);
      font-weight: 500;
    }

    tbody tr:hover {
      background: var(--menu-btn-bg-hover);
    }

    .in-progress {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
  }
</style>
