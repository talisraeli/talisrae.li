---
import Image from "astro/components/Image.astro";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  width?: number;
}

const { src, alt, caption, width = 800 } = Astro.props;
---

<figure>
  <Image src={src} alt={alt} decoding="async" width={width} quality="high" format="webp" />
  <figcaption>{caption}</figcaption>
</figure>

<style lang="scss">
  figure {
    margin: 1rem 0;
    text-align: center;

    :global(img) {
      max-width: clamp(80%, 500px, 100%);
      height: auto;
    }
  }

  figcaption {
    margin-block-start: 0.25rem;
    font-size: 0.85rem;
  }
</style>
