---
import GreenLightIcon from "../assets/icons/green-light-icon.svg";

interface Props {
  size?: number;
}

const { size = 16 } = Astro.props;
---

<GreenLightIcon
  class="green-light"
  width={size}
  height={size}
  viewBox="-10 -10 252.33508 252.33508"
  aria-hidden="true"
/>

<style>
  :global(svg.green-light) {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(svg.green-light) {
      animation: green-light-pulse 2.5s ease-in-out infinite;
    }
  }

  @keyframes green-light-pulse {
    0%,
    100% {
      filter: drop-shadow(0 0 1.5px rgb(25 240 0 / 0.6));
    }
    50% {
      filter: drop-shadow(0 0 3.5px rgb(25 240 0 / 0.8));
    }
  }
</style>
