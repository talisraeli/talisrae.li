---
import PopupDialog from "./PopupDialog.astro";
import Icon from "../../../public/favicon.svg";

const year = new Date().getFullYear();
const version = "0.0.1";
---

<PopupDialog id="about-dialog" title="About" width="380px">
  <div class="about-content">
    <div class="about-header">
      <Icon />
      <div class="about-info">
        <h2>Tal Israeli's Portfolio</h2>
        <p class="version">Version {version}</p>
      </div>
    </div>

    <p class="description">
      A personal portfolio website with a design inspired by the Windows Presentation Foundation (WPF) desktop
      application aesthetic. Built with{" "}
      <a href="https://astro.build" target="_blank" rel="noopener">
        Astro
      </a>
      .
    </p>

    <div class="about-footer">
      <p>&copy; {year} Tal Israeli</p>
      <p>
        <a href="https://github.com/talisraeli/talisrae.li" target="_blank" rel="noopener">
          github.com/talisraeli/talisrae.li
        </a>
      </p>
    </div>
  </div>
</PopupDialog>

<style lang="scss">
  .about-content {
    font-size: 0.82rem;

    .about-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;

      :global(svg) {
        width: 48px;
        height: 48px;
        flex-shrink: 0;

        :global(*) {
          fill: cornflowerblue !important;
        }
      }

      .about-info {
        h2 {
          font-size: 1rem;
          font-weight: 600;
          margin: 0;
        }

        .version {
          font-size: 0.78rem;
          margin: 0.15rem 0 0;
          opacity: 0.7;
        }
      }
    }

    .description {
      line-height: 1.5;
      margin: 0 0 1rem;

      a {
        color: cornflowerblue;
        text-decoration: none;

        &:hover {
          text-decoration: underline;
        }
      }
    }

    .about-footer {
      border-top: 1px solid var(--window-border);
      padding-top: 0.75rem;

      p {
        margin: 0.15rem 0;
      }

      a {
        color: cornflowerblue;
        text-decoration: none;
        font-size: 0.78rem;

        &:hover {
          text-decoration: underline;
        }
      }
    }
  }
</style>
