---
const currentYear = new Date().getUTCFullYear();
---

<footer>
  <ul class="legal">
    <li>&copy; {currentYear} Tal Israeli</li>
    <li>
      <a href="/terms-of-service">Terms</a>
    </li>
    <li>
      <a href="/privacy-policy">Privacy</a>
    </li>
    <li>
      <button type="button" class="link" data-action="help-cookies">
        Manage Cookies
      </button>
    </li>
  </ul>
</footer>

<style>
  footer {
    padding: 0.25rem 1rem;
    font-size: 0.8rem;

    ul.legal {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0 1rem;
    }

    button.link {
      padding: 0;
      border: none;
      background: none;
      color: var(--link-color);
      font: inherit;
      text-decoration: underline;
      cursor: pointer;
    }
  }
</style>
